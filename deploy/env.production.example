# Template for /srv/bizvision-agents/.env on the production server (chmod 600, owner deploy).
# Names only: real values live on the server, never in git (this repo is public).
# Production keys only. Dev keys must never be copied to the server (see docs/runbook-m7.md).

# Neon "production" branch, DIRECT (non-pooled) connection string, SQLAlchemy scheme prefix.
# Host must NOT contain "-pooler". Both variables hold the same value (ADR-001).
#   postgresql+asyncpg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
DATABASE_URL_DIRECT=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=BizVision AI <ai@notify.bizvision.fi>

# Admin API: `openssl rand -base64 48`. Empty means every admin route answers 503.
ADMIN_API_KEY=

PUBLIC_BASE_URL=https://agents.bizvision.fi
# Exactly one proxy (Caddy) in front of the API. Read by the app, not by uvicorn (ADR-008).
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
# /docs and /openapi.json stay off in production.
ENABLE_DOCS=false
