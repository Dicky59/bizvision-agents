[Unit]
Description=BizVision agents: retention cleanup (expired conversations, old leads)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
SupplementaryGroups=docker
WorkingDirectory=/srv/bizvision-agents
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml run --rm -T api bv cleanup
